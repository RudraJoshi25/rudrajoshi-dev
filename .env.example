# ---- Contact form (Express + nodemailer, server.js) ----
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_TO=your-gmail@gmail.com

# Base URL of the Express contact server (server.js). Defaults to
# http://localhost:5000 when unset.
REACT_APP_API_URL=http://localhost:5000

# ---- PersonaQuery (FastAPI RAG backend) ----
# Local dev:  http://127.0.0.1:8000
# Production: https://<your-service>.onrender.com
REACT_APP_PERSONAQUERY_URL=http://127.0.0.1:8000
